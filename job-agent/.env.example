# --- LLM ---
OPENAI_API_KEY=replace_me
PLANNER_MODEL=gpt-4o
EXTRACTION_MODEL=gpt-4o-mini
RAG_MODEL=gpt-4o-mini
FRONTIER_MODEL=gpt-4o
FAST_MODEL=gpt-4o-mini
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# --- Browser ---
PROXY_URL=
STEALTH_MODE=true
BROWSER_HEADLESS=true

# --- Safety gates (defaults are safe) ---
REQUIRE_APPROVAL=true
DRY_RUN=true
STOP_ON_CAPTCHA=true
STOP_ON_AMBIGUOUS=true
MAX_APPLIES_PER_DAY=10
MAX_ITERATIONS_PER_RUN=25

# --- Storage ---
DATABASE_PATH=data/jobpilot.sqlite3
QA_CACHE_PATH=data/qa_cache.json
RESUME_EXPANDED_PATH=data/resume_expanded.txt
RESUME_PDF_PATH=
VECTOR_DB_PATH=data/vector_db
AUDIT_LOG_PATH=logs/audit.log

# --- Scoring weights (sum is normalized, individual weights matter for ranking) ---
SCORE_TITLE_WEIGHT=0.45
SCORE_LOCATION_WEIGHT=0.20
SCORE_RESUME_WEIGHT=0.35
SCORE_MIN_ACCEPT=0.55

# --- API service ---
API_HOST=127.0.0.1
API_PORT=8000
LOG_FORMAT=json
LOG_LEVEL=INFO

# --- Discovery ---
# Comma-separated public board slugs.
# Example: GREENHOUSE_COMPANIES=stripe,airbnb   LEVER_COMPANIES=palantir,figma
GREENHOUSE_COMPANIES=
LEVER_COMPANIES=
DISCOVERY_HTTP_TIMEOUT=15
